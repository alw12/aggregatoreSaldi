# Password per accedere all'app
APP_PASSWORD=
# Opzionale: password dell'utente bot (accesso separato, revocabile cambiandola o togliendola)
# BOT_PASSWORD=
# Segreto per firmare il cookie di sessione (min 32 caratteri): openssl rand -base64 48
AUTH_SECRET=

# Enable Banking – Application ID (kid) dal Control Panel
EB_APP_ID=
# Chiave privata .pem dell'applicazione, in base64 su una riga: base64 -w0 <file>.pem  (macOS: base64 -i <file>.pem)
EB_PRIVATE_KEY=
# Opzionale: forza il redirect URL (default: https://<host>/api/eb/callback)
# EB_REDIRECT_URL=https://saldi-xxx.vercel.app/api/eb/callback

# Upstash Redis (impostate in automatico dall'integrazione Vercel Marketplace, prefisso SALDI)
SALDI_KV_REST_API_URL=
SALDI_KV_REST_API_TOKEN=
# in alternativa:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Dopo quanti minuti i saldi salvati vengono riletti dalla banca in background (default 30)
# BALANCE_CACHE_MINUTES=30
# Secondi massimi di attesa di una banca prima di usare l'ultimo saldo letto (default 10)
# EB_TIMEOUT_SECONDS=10

# Token per /api/portfolio/sync (sincronizzazione automatica Scalable), min 32 caratteri: openssl rand -hex 32
# SYNC_TOKEN=

# Job giornaliero /api/cron/daily (vercel.json): Vercel lo chiama con "Authorization: Bearer CRON_SECRET". openssl rand -hex 32
# CRON_SECRET=
# Notifiche push: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://<tuo-dominio>

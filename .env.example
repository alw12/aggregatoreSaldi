# Password per accedere all'app
APP_PASSWORD=
# Segreto per firmare il cookie di sessione (min 32 caratteri): openssl rand -base64 48
AUTH_SECRET=

# Enable Banking – Application ID (kid) dal Control Panel
EB_APP_ID=
# Chiave privata .pem dell'applicazione, in base64 su una riga: base64 -w0 <file>.pem  (macOS: base64 -i <file>.pem)
EB_PRIVATE_KEY=
# Opzionale: forza il redirect URL (default: https://<host>/api/eb/callback)
# EB_REDIRECT_URL=https://saldi-xxx.vercel.app/api/eb/callback

# Upstash Redis (impostate in automatico dall'integrazione Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Minuti di cache dei saldi (default 30)
# BALANCE_CACHE_MINUTES=30
